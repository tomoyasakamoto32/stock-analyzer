{
  "name": "stock-analyzer",
  "type": "module",
  "private": true,
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "dev": "npm run build:client && wrangler dev",
    "deploy": "npm run build:client && wrangler deploy --minify",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsc -p tsconfig.test.json",
    "test": "node --test tests/",
    "db:migrate:local": "wrangler d1 migrations apply stock-analyzer-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply stock-analyzer-db --remote",
    "poc": "node scripts/poc.mjs"
  },
  "dependencies": {
    "hono": "^4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261121.1",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "wrangler": "^4.110.0"
  }
}
